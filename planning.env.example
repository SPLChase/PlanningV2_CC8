# Local data folders
RAW_DIR=data/raw
STAGE_DIR=data/stage
OUTPUT_DIR=data/output
REFERENCE_DIR=Reference
SAMPLES_DIR=Samples
CC8_SOURCE_ROOT=C:/dev/cc8
EXCO_SOURCE_DIR=C:/dev/cc8/Exco/source_data
EXCO_OUTPUT_DIR=C:/dev/cc8/Exco/output/csv
MINSTOCK3_DIR=C:/dev/cc8/MinStock3

# SAP Business One Service Layer
SAP_URL=https://your-sap-host:50000/b1s/v1
SAP_COMPANY=YOUR_COMPANY_DB
SAP_USER=YOUR_USER
SAP_PASSWORD=YOUR_PASSWORD
SAP_VERIFY_SSL=false
ODATA_MAX_PAGE_SIZE=500

# CoCre8 stock extract query
SQL_QUERY_CODE=CC8_PLANNING_V2_STOCK_RAW
GROUP_MIN=105
GROUP_MAX=106
